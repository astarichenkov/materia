# Build output
target/
node_modules/
__pycache__/
*.pyc
e2e/test-results/
e2e/playwright-report/
*.class
*.jar
*.war

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws
.settings/
.project
.classpath

# OS
.DS_Store
Thumbs.db

# Runtime data / local artifacts (never commit models, media, generated docs)
data/
uploads/
output/
*.mp4
*.mkv
*.mov
*.wav
*.m4a
*.bin
*.gguf
*.onnx

# Snapshots are generated via git worktree and must not be committed
snapshots/*
!snapshots/.gitignore

# Project export archives
lecture-processor.zip
lecture-processor-*.zip

# Logs
*.log
logs/

# Secrets
.env
*.local
secrets.properties
# Per-installation credential master key (must never be committed)
.secrets/
master.key
*.key

# Internal working docs / agent instructions (kept locally, never published)
AGENTS.md
docs/

# SQLite databases
*.db
*.sqlite
*.sqlite3
