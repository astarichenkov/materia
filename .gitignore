# Build output
target/
node_modules/
__pycache__/
*.pyc
e2e/test-results/
e2e/playwright-report/
*.class
*.jar
*.war

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws
.settings/
.project
.classpath

# OS
.DS_Store
Thumbs.db

# Runtime data / local artifacts (never commit models, media, generated docs)
data/
uploads/
output/
*.mp4
*.mkv
*.mov
*.wav
*.m4a
*.bin
*.gguf
*.onnx

# Snapshots are generated via git worktree and must not be committed
snapshots/*
!snapshots/.gitignore

# Project export archives (never published)
*.zip
*.rar
*.7z
*.tar
*.tar.gz
lecture-processor*.rar

# Logs
*.log
logs/

# Secrets — real values live only in the environment or local .env
.env
.env.*
!.env.example
*.local
secrets.properties
# Per-installation credential master key (must never be committed)
.secrets/
master.key
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore

# Internal working docs / agent instructions (kept locally, never published)
AGENTS.md
AGENTS.override.md
# Working journal that may reference local infrastructure
**/RESUME.md

# SQLite databases and journals
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
