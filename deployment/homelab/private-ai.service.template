[Unit]
Description=Private AI Chat Service (Day 30)
Documentation=file:/opt/private-ai/README.md
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=private-ai
Group=private-ai
WorkingDirectory=/opt/private-ai
EnvironmentFile=/etc/private-ai/private-ai.env

# CPU-only host: small bounded heap is sufficient.
ExecStart=/opt/java/current/bin/java -Xms128m -Xmx512m -XX:+UseSerialGC -jar /opt/private-ai/private-ai-chat.jar --spring.config.additional-location=file:/etc/private-ai/

SuccessExitStatus=143
Restart=on-failure
RestartSec=5

# Hardening. NOTE: this host is an unprivileged LXC. ProtectSystem=strict,
# ProtectKernelTunables and ProtectControlGroups fail with status=226/NAMESPACE
# here, so only the options verified to work in this container are enabled.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
