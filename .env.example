# Materia — configuration example.
# Copy to .env (never commit a real .env) or export the variables in your shell.
# All values below are placeholders; the project runs without any cloud key.

# --- Storage and pipeline ---------------------------------------------------
LECTURE_STORAGE_ROOT=./data
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WHISPER_PATH=whisper-cli
WHISPER_MODEL_PATH=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Private AI chat module -------------------------------------------------
CHAT_PORT=8081
CHAT_BIND_ADDRESS=127.0.0.1
CHAT_MODEL=qwen3:1.7b
CHAT_TIMEOUT=2m
CHAT_THINK=false
CHAT_API_KEY=
# Only set true behind a trusted reverse proxy (rate-limit spoofing protection)
CHAT_TRUST_FORWARDED_FOR=false

# --- Cloud LLM (optional) ---------------------------------------------------
# The API key is entered through the settings UI and stored encrypted at rest
# (AES-256-GCM). Do not put it in this file.
DEEPSEEK_ENABLED=false
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MODELS=deepseek-flash

# Master key for encrypting provider credentials. Prefer the environment;
# the file fallback is created under ${LECTURE_STORAGE_ROOT}/.secrets/.
# Generate with: head -c 32 /dev/urandom | base64
LP_MASTER_KEY=
# Administrative token for /settings and /code-review (empty = localhost only).
LP_ADMIN_TOKEN=

# --- Gitea integration (optional, AI code review) ---------------------------
# Use your own Gitea instance; the token is read from the environment only.
GITEA_URL=https://gitea.example.com
GITEA_BASE_URL=https://gitea.example.com
GITEA_TOKEN=
# Allow plain HTTP only for a trusted local instance.
GITEA_ALLOW_HTTP=false
# Comma-separated allow-list of trusted Gitea hosts (token destination guard).
# GITEA_TRUSTED_HOSTS=gitea.example.com,127.0.0.1
# Comma-separated owner/repo allow-list; empty denies every repository.
GITEA_ALLOWED_REPOS=
# HMAC secret for the Gitea webhook; generate your own, never reuse.
GITEA_WEBHOOK_SECRET=

# --- Optional integration toggles -------------------------------------------
ASSISTANT_AUTO_INDEX=true
CODE_REVIEW_ENABLED=true
FILE_AGENT_ENABLED=true

# --- yt-dlp (optional) ------------------------------------------------------
# none | browser | file
YTDLP_COOKIES_MODE=none
YTDLP_COOKIES_BROWSER=
YTDLP_COOKIES_PROFILE=
YTDLP_COOKIES_FILE=
