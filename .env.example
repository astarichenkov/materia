# Copy to .env (never commit real secrets) or export in your shell.

# Lecture Processor backend
LECTURE_STORAGE_ROOT=./data
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WHISPER_PATH=whisper-cli
WHISPER_MODEL_PATH=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Private AI chat (Day 30)
CHAT_PORT=8081
CHAT_BIND_ADDRESS=127.0.0.1
CHAT_MODEL=qwen3:1.7b
CHAT_TIMEOUT=2m
CHAT_THINK=false
CHAT_API_KEY=
# Only set true behind a trusted reverse proxy (rate-limit spoofing protection)
CHAT_TRUST_FORWARDED_FOR=false

# Gitea REST API (used by scripts/gitea-client.py).
# Keep the real token ONLY in your shell environment or an untracked .env.
# Never commit it, never put it into a Git remote URL.
GITEA_URL=http://203.0.113.20:8108
GITEA_TOKEN=
# Optional comma-separated allow-list of trusted Gitea hosts.
# GITEA_TRUSTED_HOSTS=203.0.113.20,127.0.0.1
